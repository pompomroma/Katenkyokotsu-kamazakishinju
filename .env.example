# Copy these into Replit > Tools > Secrets (preferred)
# or into a local .env file for off-Replit testing.

# Required.  Get keys free from https://build.nvidia.com/  ->  any model page  ->  "Get API Key"
# Both can be the same nvapi-... key, or two separate keys if you prefer.
TEXT_API_KEY=nvapi-your-key-for-the-chat-model
VISUAL_API_KEY=nvapi-your-key-for-the-vision-model

# Optional overrides
# VISION_TEXT_MODEL=meta/llama-3.3-70b-instruct
# VISION_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# PORT=8080
