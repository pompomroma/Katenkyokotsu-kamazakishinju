# Copy these into Replit > Tools > Secrets (preferred)
# or into a local .env file for off-Replit testing.

# Required.  Get it free from https://build.nvidia.com/  ->  any model page  ->  "Get API Key"
NVIDIA_API_KEY=nvapi-your-key-here

# Optional overrides
# VISION_TEXT_MODEL=meta/llama-3.3-70b-instruct
# VISION_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# PORT=8080
